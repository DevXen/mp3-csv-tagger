class ElementTemplate {

    function this(tag, value) {
        this._attributes = {};
        this._properties = {};
        this._tag = tag;
        this._value = value;
        this._id = null;
        this._classes = [];
        this._styles={};
        this._children = [];
    }

    function attribute(name, value) {
        this._attributes[name] = value;
    }

    function get(name) {
        return this._properties[name];
    }

    function set(name, value) {
        this._properties[name] = value;
    }

    function child(child) {
        this._children.push(child);
    }

    function value(value) {
        this._value = value;
    }

    function id(id) {
        this._id = id;
    }

    function addClass(name) {
        this._classes.push(name);
    }

    function removeClass(name) {
        var newClasses = [];
        for (var i = 0; i <= this._classes.length-1; i++) {
            var cls = this._classes[i];
            if (cls !== name) {
                newClasses.push(cls);
            }
        }

        this._classes = newClasses;
    }

    function style(name, value) {
        this._styles[name] = value;
    }

    function html(use_value=undefined) {

        var html = "<"+this._tag;

        for (var name in this._attributes) {
            var value = this._attributes[name];
            html += " "+name + "= \"" + value + "\"";
        }

        var classes = "";
        for (var i=0; i <= this._classes.length-1; i++) {
            var cls = this._classes[i];
            if (i > 0) {
               classes +=" ";
            }
            classes += cls;
        }
        if (classes.length > 0) {
           classes = " class=\""+classes+"\" ";
        }

        var styles = "";
        var count = 0;
        for (var name in this._styles) {
            count +=1;
            var value = this._styles[name];
            if (count > 1) {styles += ";"}
            styles += name + ": " + value;
        }
        if (styles.length > 0) {
            styles=" style=\""+styles+"\"";
        }

        html += classes + styles;

        if (this._id !== undefined && this._id !== null) {
            html += " #"+this._id;
        }

        html += ">"

        if (this._children.length > 0) {
            for (var child in this._children) {
                html += child.html();
            }
        }
        else if (use_value !== undefined && use_value !== null) {
            html += use_value;
        }
        else {
            if (this._value !== undefined && this._value !== null) {
                html += this._value;
            }
        }

        html += "</"+this._tag+">";

        return html;
    }

}

class DivTemplate : ElementTemplate {

    function this(value=undefined) {
        super("div",value);
    }
}

class RowTemplate : DivTemplate {

    function this(value=undefined) {
        super(value);
        this.addClass("row");
    }
}

class CellTemplate : DivTemplate {

    function this(value=undefined) {
        super(value);
        this.addClass("cell");
    }
}


class FixedColumnTable : Behavior
{

    this var _data = null;
    this var _headings = null;

    function attached () {

        var id = this.@["id"];
        this.@["class"] = "fixed-column-table";

        this.fixed_header = new Element ("div");
        this.fixed_header.@["class"] = "fixed-column-table-fixed-header";
        this.fixed_header.@["id"] = id+"-table-fixed-header";
        this.insert(this.fixed_header);

        this.fixed_table = new Element ("div")
        this.fixed_table.@["class"] = "fixed-column-table-fixed";
        this.fixed_table.@["id"] = id+"-table-fixed";
        this.insert(this.fixed_table);

        this.scrollable_table = new Element ("div");
        this.scrollable_table.@["class"] = "fixed-column-table-scrollable";
        this.scrollable_table.@["id"] = id+"-table-scrollable";
        this.insert(this.scrollable_table);

        this.footer = new Element ("div")
        this.footer.@["class"] = "fixed-column-table-footer";
        this.footer.@["id"] = id+"-footer";
        this.insert(this.footer);

        this.data = property (v) {
            get return this._data;
            set {
               this._data = v;
            }
        }

        this.headings = property (v) {
            get return this._headings;
            set {
               this._headings = v;
            }
        }

        this.refreshTable = function () {

            this.current_vertical_scroll = 0;
            this.current_horizontal_scroll = 0;

            //Clear contents
            this.scrollable_table.html=" ";
            this.fixed_table.html=" ";
            //Reset scroll positions as well.
            this.scrollable_table.scrollTo (0,0);
            this.fixed_table.scrollTo (0,0);

            var cellTemplate = new CellTemplate();

            //Headings must be provided before this can be refreshed
            if (this._headings === undefined || this._headings === null || this._headings.length === 0) return;

            //Set fixed heading
            this.fixed_header.html = cellTemplate.html(this._headings[0]);

            //Scrollable headings
            var rowTemplate = new RowTemplate();
            // This ID will be used by the event handlers below to adjust the position of the scrolling table
            // header row.
            rowTemplate.id("scrollable-headings-row");
            rowTemplate.addClass("heading-row");
            for (var i=1; i <= this._headings.length-1; i++) {
                var heading = this._headings[i];
                var cell = new CellTemplate();
                cell.value(heading.title);
                rowTemplate.child(cell);
            }
            this.scrollable_table.append(rowTemplate.html(cells));

            //Insert dummy row
            rowTemplate = new RowTemplate();
            this.scrollable_table.append(rowTemplate.html());

            //Append rows
            for (var ri=0; ri<=this._data.length-1;ri++) {
                var row = this._data[ri];
                var rowTemplate = new RowTemplate();

                if (ri % 2 == 1) {
                    rowTemplate.addClass("alt-row")
                }

                // Create row with value for fixed portion of table.
                var cell = new CellTemplate(row[0]);
                this.sendEvent ("fixed-cell", {"cell": cell, "row": row, "cell_index": 0});
                this.fixed_table.append (rowTemplate.html(cell.html()));

                // Create scrollable table row using remainder of headings
                for (var hi=1; hi <= this._headings.length-1; hi++) {
                    var heading = this._headings[hi];

                    var cell = new CellTemplate();
                    cell.value(row[hi])
                    this.sendEvent ("scroll-cell", {"cell": cell, "row": row, "heading":heading, "cell_index": hi});

                    rowTemplate.child(cell);

                }
                this.scrollable_table.append(rowTemplate.html());

            }

            // Raise a "refreshed" event
            self.sendEvent ("refreshed")

        }

        this.initializeEvents();

    }

    /**
     *
     */
    function initializeEvents () {

        var myself = this;

        this.current_vertical_scroll = 0;
        this.current_horizontal_scroll = 0;

        var adjustHeaderPosition = function (newScrollPosition) {
           var headings = $(#scrollable-headings-row);
            headings.style.set {
               top: newScrollPosition
            }
        };

        //Listen for resizing of the main view/window.
        view.on("size", function (e) {
            //myself.fixed_table.scrollTo(0, myself.current_vertical_scroll);
            //myself.scrollable_table.scrollTo (myself.current_horizontal_scroll, myself.current_vertical_scroll);
            //adjustHeaderPosition(0);
            myself.refreshTable();
        });

        this.fixed_table.onScroll = function (evt) {
              // NOTE: It is important to check the type of event as, for example, clicking down
              // on a scrollbar and then releasing will fire two events. The clicking down event
              // appears to have a scroll position of 0 and the release event has the real scroll position.
              // This causes "flickering" if adjusting on both events.
              if (evt.type == Event.SCROLL_POS) {
                  if (evt.scrollAxis == "vertical") {
                     myself.current_vertical_scroll = evt.scrollPos;
                     adjustHeaderPosition(evt.scrollPos);
                     myself.scrollable_table.scrollTo (myself.current_horizontal_scroll, evt.scrollPos);
                  }
              }
        }

        this.scrollable_table.onScroll = function (evt) {
        
              // NOTE: It is important to check the type of event as, for example, clicking down
              // on a scrollbar and then releasing will fire two events. The clicking down event
              // appears to have a scroll position of 0 and the release event has the real scroll position.
              // This causes "flickering" if adjusting on both events.
              if (evt.type == Event.SCROLL_POS) {
                  if (evt.scrollAxis == "vertical") {
                     myself.fixed_table.scrollTo (0, evt.scrollPos);
                     adjustHeaderPosition(evt.scrollPos);
                  }
                  else
                  if (evt.scrollAxis == "horizontal") {
                     myself.current_horizontal_scroll = evt.scrollPos;

                  }
              }
        }

        this.scrollable_table.on("mousewheel", function (evt) {
            var abs = Math.abs(evt.wheelDelta).toInteger() * 10;
            if (evt.wheelDelta > 0) {
                // Only allow scrolling if the scroll position has not going beyong the top (< 0).
                myself.current_vertical_scroll -= abs;
                if (myself.current_vertical_scroll < 0) {
                    myself.current_vertical_scroll  = 0;
                }
                myself.fixed_table.scrollTo(0, myself.current_vertical_scroll);

                adjustHeaderPosition(myself.current_vertical_scroll);

                myself.scrollable_table.scrollTo(myself.current_horizontal_scroll, myself.current_vertical_scroll);
            }
            else
            if (evt.wheelDelta < 0) {

                myself.current_vertical_scroll += abs;
                // Set the current scroll position back to what it was if it has
                // gone past the bottom (bottom is the height of the content within the table (i.e. all the rows,
                // visible or not) minus the height of the visible portion of the table.
                var bottom = myself.fixed_table.box(#height,#content) - myself.fixed_table.box(#height);
                if (myself.current_vertical_scroll > bottom) {
                    myself.current_vertical_scroll = bottom;
                }

                myself.fixed_table.scrollTo(0, myself.current_vertical_scroll);
                adjustHeaderPosition(myself.current_vertical_scroll);
                myself.scrollable_table.scrollTo(myself.current_horizontal_scroll, myself.current_vertical_scroll);
            }

        });

    }

}