class Observable {

    function this() {
        this.listeners = {};
    }

    function listen(event_code, listener, priority=9999) {


        var event_listeners = this.listeners[event_code];
        if (event_listeners === undefined) {
            event_listeners = {}
            this.listeners[priority] = event_listeners;
        }

        var priority_listeners = event_listeners[priority];
        if (priority_listeners === undefined) {
            priority_listeners = []
            event_listeners[priority] = priority_listeners;
        }

        priority_listeners.push(listener)
        event_listeners[priority] = priority_listeners;
        this.listeners[event_code] = event_listeners;
    }

    function clear () {
        this.listeners = {}
    }

    function notify (event_code, data) {

        var event_listeners = this.listeners[event_code];
        if (event_listeners !== undefined) {
            var keys = event_listeners.keys();
            keys.sort (function (p1,p2) { return p1-p2 });
            for (var key in keys) {
                var priority_listeners = event_listeners[key];
                for (var listener in priority_listeners) {
                    listener(data);
                }
            }
        }
    }
}

var globalEvents = new Observable();