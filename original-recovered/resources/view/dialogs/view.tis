function show_info_dialog (content, title) {
    view.dialog {
         url: self.url(view.views().dialogs.get_relative_resource_path("info.html")),
         x:300,
         y:300,
         width: 400,
         height: 300,
         alignment:5,
         parameters: {
            "content": content,
            "title": title
         }
      };
}

function show_confirm_dialog (content, title, yes_callback) {
    view.dialog {
         url: self.url(view.views().dialogs.get_relative_resource_path("confirmation.html")),
         x:300,
         y:300,
         width: 400,
         height: 220,
         alignment:5,
         parameters: {
            "content": content,
            "title": title,
            "yes_callback": yes_callback
         }
      };
}