function initialize_navigation() {

    var buttons = $$(navigation-bar-button)
    for (var button in buttons) {
        button.on("click", function (e) {
            var container = this.attributes["container"]
            var ctrl_key = e.ctrlKey
            view.controllers().navigation.on_nav_button_click(this.attributes["id"], container, ctrl_key);
        })
    }

}