var files_list = $(#files-list);

class Mp3PathsDataSource {

    function this() {
        this.paths = view.controllers().files.get_mp3_paths()
    }

    function size() {
        return this.paths.length;
    }

    function get(index) {
        var path = this.paths[index]
        return {index: index, caption: path}
    }

    function refresh () {
        this.paths = view.controllers().files.get_mp3_paths()
    }
}

files_list.records = new Mp3PathsDataSource();

function refresh_files () {
    /*
     NOTE: The vlist component appears to not like having its data source messed with once its been set, it
     can be set but there appears to be a bug/feature stopping it working correctly.
     So have to resort creating a new vlist component.
     */
    var files_container = $(#files-list-container)
    files_container.html = "<vlist #files-list><li><span name=\"caption\">???</span></li></vlist>"
    var files_list = $(#files-list);
    files_list.records = new Mp3PathsDataSource();
    //files_list.records.refresh();
    //files_list.refresh();
}

function initialize_files() {


    function addFile () {

        const filter = "MP3 Files (*.mp3)|*.mp3;";
        const defaultExt = "mp3";
        //const initialPath = System.path(#USER_DOCUMENTS);
        const initialPath = "";
        const caption = "Select MP3 file";

        var urls = view.selectFile(#open-multiple, filter, defaultExt, initialPath, caption );

        if (urls) {
            //If only one file is selected, it will be returned as a string and not an array.
            if (typeof urls == "string") {
                urls = [urls]
            }
            var paths = []
            for (var url in urls) {
                var path = URL.toPath(url);
                paths.push(path);
            }
            // Pass to csv view in Python
            view.controllers().files.add_file(paths);
        }
    }

    function addFolder () {

        var folder = view.selectFolder("Select a folder to include." /*,"D:/" */);
        if (folder) {
            var path = URL.toPath(folder);
            view.controllers().files.add_folder(path);
        }

    }

    $(#add-file-button).on("click", function () {
        addFile();
    });
    $(#add-file).on("click", function () {
        addFile();
    });

    $(#add-folder-button).on("click", function () {
        addFolder();
    });

    $(#add-folder).on("click", function () {
        addFolder();
    });

    $(#delete-file-folder).on("click", function () {
       // Get a fresh copy of files_list as, if the list is refreshed
       // above, this function gets to keep the old copy which creates
       // a rift in the space-time continuum.
       var files_list = $(#files-list);
       var index = files_list.currentIndex;
       var record = files_list.records.get(index);

       view.controllers().files.delete_path(record.caption);
    });

}