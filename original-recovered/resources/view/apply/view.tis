function initialize_apply() {

    var run_apply_button = $(#run-apply);
    var apply_output = $(.apply-output);
    var apply_logback_folder = $(.apply-logback-folder);
    var choose_logback_folder = $(#choose-logback-folder);

    run_apply_button.on("click", function () {
        run_apply_button.enabled = false;
        try {
            view.controllers().apply.run();
        }
        finally {
            run_apply_button.enabled = true;
        }
    });

    apply_logback_folder.value = view.controllers().apply.get_apply_logback_folder()
    choose_logback_folder.on("click", function () {
        var folder = view.selectFolder("Select a log/backup folder." /*,"D:/" */);
        if (folder !== undefined && folder !== null && folder.length > 0) {
            folder = URL.toPath(folder);
            folder = view.controllers().apply.set_apply_logback_folder (folder);
            apply_logback_folder.value = folder
        }
    });

}

function refresh_apply_logback_folder () {
     var apply_logback_folder = $(.apply-logback-folder);
     apply_logback_folder.value = view.controllers().apply.get_apply_logback_folder()
}

function clear_updates() {
    var apply_output = $(.apply-output);
    apply_output.html = " ";
}

function apply_update(msg) {
    var apply_output = $(.apply-output);
    apply_output.append(msg);
    apply_output.append("<br/>");
}