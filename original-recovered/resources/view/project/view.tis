function save_project_as () {

    const filter = "MP3 Project Files (*.mp3p)|*.mp3p;";
    const defaultExt = "mp3p";
    const initialPath = System.path(#USER_DOCUMENTS);
    //const initialPath = "";
    const caption = "Select MP3 Project file";

    var url = view.selectFile(#save, filter, defaultExt, initialPath, caption );
    if (url) {
        var path =  URL.toPath(url);
        return path
    }
    return null;
}

function load_project_from () {

    const filter = "MP3 Project Files (*.mp3p)|*.mp3p;";
    const defaultExt = "mp3p";
    const initialPath = System.path(#USER_DOCUMENTS);
    //const initialPath = "";
    const caption = "Select MP3 Project file";

    var url = view.selectFile(#open, filter, defaultExt, initialPath, caption );
    if (url) {
        var path =  URL.toPath(url);
        return path
    }
    return null;
}