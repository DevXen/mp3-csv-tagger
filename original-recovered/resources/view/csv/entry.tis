
$(#entry_include_{{entry.id}}).on("change", function () {
    var entry = $(#entry_{{entry.id}})
    var entry_id = {{entry.id}}
    view.controllers().csv.include_changed ({{entry.id}}, this.value)
});

//Delete CSV entry
$(#entry_delete_{{entry.id}}).on("click", function () {
    view.controllers().csv.delete_csv_entry({{entry.id}});
});

//Move CSV entry up
$(#entry_moveup_{{entry.id}}).on("click", function () {
    view.controllers().csv.move_entry_up({{entry.id}});
});

//Move CSV entry down
$(#entry_movedown_{{entry.id}}).on("click", function () {
    view.controllers().csv.move_entry_down({{entry.id}});
});

//Update CSV entry
$(#entry_update_{{entry.id}}).on("click", function () {
    view.controllers().csv.update_csv_entry_tags({{entry.id}});
});

{% for tag in tags %}
$(#tag_{{tag.id}}).on("change", function () {
    var tag_id = {{tag.id}};
    var value = this.value;
    view.controllers().csv.tag_changed (tag_id, value);
})
{% endfor %}