
class CSVHandler {

    function this() {

         this.setupListeners();
         this.csv = {};
         this.entry_seq = 0;
    }

    function setupListeners () {

        self.on("click","#add-csv", function () {
            const filter = "CSV Files (*.csv)";
            const defaultExt = "csv";
            //const initialPath = System.path(#USER_DOCUMENTS);
            const initialPath = view.get_configuration_value ("project/csv_default_folder","c:/");
            const caption = "Select CSV file";

            var url = view.selectFile(#open, filter, defaultExt, initialPath, caption );
            if( url ) {
                var path = URL.toPath(url);
                // Pass to csv view in Python
                view.controllers().csv.add_csv(path);

            }
        });

    }

}

var csvHandler = new CSVHandler();
